# Salin file ini menjadi `.env` lalu isi nilainya.
#
#   cp .env.example .env
#
# `.env` sudah masuk .gitignore dan TIDAK BOLEH di-commit.
# Jangan pernah menuliskan nilai kredensial asli di file ini.
# Kredensial yang diminta di bawah hanya dibutuhkan untuk Tahap B (retrieval teks).

# ---------------------------------------------------------------- Reddit
# SEJAK Nov 2025 Reddit menutup pembuatan app mandiri: membuka
# https://www.reddit.com/prefs/apps hanya mengarah ke halaman kebijakan
# "Responsible Builder Policy". Akses Data API sekarang lewat permohonan manual:
#   https://support.reddithelp.com/hc/en-us/requests/new?ticket_form_id=14868593862164
#   (jenis permohonan: Developer, bukan Researcher/Enterprise)
# Kredensial baru bisa diisi SETELAH permohonan itu disetujui. Lihat
# docs/tahap-b-reddit.md untuk isi jawaban formulir dan rencana cadangan.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=moneyball-nlp/0.1 (academic project)

# ---------------------------------------------------------------- YouTube
# Google Cloud Console > enable "YouTube Data API v3" > API key.
# Wajib: scrapers use playlistItems.list, not search.list (quota).
YOUTUBE_API_KEY=
